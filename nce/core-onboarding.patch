+def studio_config():
+    return {'version': 1, 'branding': {'appName': 'Game Studio', 'badgeText': 'Powered by Game Studio', 'accentColor': '#176a63'},
+        'hosts': [{'id': 'academy', 'name': 'Academy lessons', 'origin': 'https://academy.example.test', 'returnPath': '/lessons/games'}]}
+
