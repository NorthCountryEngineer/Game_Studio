{
  "name": "nce-game-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "node scripts/check-config.mjs && node scripts/write-hosting-headers.mjs && npm run typecheck && vite build --mode production && node scripts/copy-hosting-headers.mjs",
    "build:preview": "npm run build:sdk && tsc --noEmit && node scripts/build-preview.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:api": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "build:sdk": "node scripts/build-sdk.mjs",
    "prebuild": "npm run build:sdk"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.17.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  }
}
